# Doopla Mobile — copie para .env e preencha com os valores do mesmo
# projeto Supabase que o painel web já usa (Project Settings > API).
# Prefixo EXPO_PUBLIC_ é obrigatório: só assim o Expo inclui a
# variável no bundle do app. Nunca coloque a service_role key aqui —
# só valores já pensados pra ficar no cliente.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Conversas Bloco 2 — base URL do painel web (Next.js) deployado, usada
# só pra escritas que precisam de um server real (resposta do
# profissional). Nunca a service_role key nem nenhum outro segredo:
# a rota autentica via Bearer <access_token da sessão deste app>.
EXPO_PUBLIC_API_BASE_URL=https://seu-dominio-do-painel.exemplo

# Professional Product UI — Foundation. Mesmo valor de
# NEXT_PUBLIC_WHATSAPP_NUMBER no painel web — número público da
# Doopla, nunca um segredo.
EXPO_PUBLIC_WHATSAPP_NUMBER=coloque-o-numero-publico-aqui
