# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Opcional: usado para montar o link de confirmação de e-mail.
# Se não definido, o app deduz a partir do host da requisição.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Doopla Intelligence OS — server-only, NUNCA prefixar com NEXT_PUBLIC_
# (isso exporia a chave ao browser). Lida só por
# src/lib/intelligence/openai-client.ts.
# OPENAI_API_KEY=coloque-a-chave-aqui

# Doopla Intelligence OS — Orchestrator/Runtime, server-only, NUNCA
# prefixar com NEXT_PUBLIC_ (isso exporia a chave ao browser). Lida só
# por src/lib/supabase/service-role.ts — nenhum client component ou
# rota exposta ao browser importa esse arquivo. Project Settings > API
# > service_role secret.
# SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui
