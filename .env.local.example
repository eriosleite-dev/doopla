# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Opcional: usado para montar o link de confirmação de e-mail.
# Se não definido, o app deduz a partir do host da requisição.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Doopla Intelligence OS — server-only, NUNCA prefixar com NEXT_PUBLIC_
# (isso exporia a chave ao browser). Lida só por
# src/lib/intelligence/openai-client.ts.
# OPENAI_API_KEY=coloque-a-chave-aqui

# Doopla Intelligence OS — Orchestrator/Runtime, server-only, NUNCA
# prefixar com NEXT_PUBLIC_ (isso exporia a chave ao browser). Lida só
# por src/lib/supabase/service-role.ts — nenhum client component ou
# rota exposta ao browser importa esse arquivo. Project Settings > API
# > service_role secret.
# SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Doopla Intelligence OS — Runtime, passo 5 (reconciler/cron),
# server-only, NUNCA prefixar com NEXT_PUBLIC_. Lida só por
# src/app/api/runtime/reconcile-pending-replies/route.ts. A Vercel
# injeta automaticamente "Authorization: Bearer $CRON_SECRET" nas
# chamadas que ela mesma dispara (vercel.json > crons) quando esta env
# var está configurada no projeto — gere um valor aleatório longo
# (ex.: openssl rand -hex 32) e cadastre em Project Settings >
# Environment Variables, nunca reaproveite outra chave.
# CRON_SECRET=coloque-um-secret-aleatorio-aqui

# Doopla Intelligence OS — Runtime, passo 6B (sender de outbound_intents),
# server-only. Secret DEDICADO, nunca o mesmo valor de CRON_SECRET
# (decisão do usuário: separar credenciais de processos com
# capacidades diferentes — o reconciler nunca fala com um provider
# externo, o sender sim). Lida só por
# src/app/api/runtime/send-outbound-intents/route.ts.
# OUTBOUND_SENDER_CRON_SECRET=coloque-outro-secret-aleatorio-aqui

# Doopla Intelligence OS — canal WhatsApp (passo 6A+6B), server-only,
# NUNCA prefixar com NEXT_PUBLIC_. Lidas só por
# src/lib/channels/whatsapp/ e pelas rotas de webhook/sender. Meta for
# Developers > seu App > WhatsApp > API Setup.
# WHATSAPP_ACCESS_TOKEN=coloque-o-access-token-aqui
# WHATSAPP_PHONE_NUMBER_ID=coloque-o-phone-number-id-aqui
# App Secret (Meta for Developers > App Settings > Basic) — usado só
# pra verificar a assinatura X-Hub-Signature-256 dos webhooks, nunca
# enviado pra Meta.
# WHATSAPP_APP_SECRET=coloque-o-app-secret-aqui
# Valor arbitrário escolhido por nós, cadastrado no painel da Meta ao
# registrar a URL do webhook (handshake de verificação, GET único).
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=coloque-outro-secret-aleatorio-aqui

# WhatsApp Inbound Foundation — número PÚBLICO da Doopla (E.164, só
# dígitos, sem "+"), usado no link wa.me da página /orcamento/[slug].
# NEXT_PUBLIC_ de propósito (diferente de WHATSAPP_PHONE_NUMBER_ID
# acima, que é interno da Graph API) — é o mesmo número que qualquer
# pessoa já vê/usa pra mandar mensagem, não um segredo.
# NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
