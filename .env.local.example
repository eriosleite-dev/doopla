# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Opcional: usado para montar o link de confirmação de e-mail.
# Se não definido, o app deduz a partir do host da requisição.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Doopla Intelligence OS — server-only, NUNCA prefixar com NEXT_PUBLIC_
# (isso exporia a chave ao browser). Lida só por
# src/lib/intelligence/openai-client.ts.
# OPENAI_API_KEY=coloque-a-chave-aqui

# Formulário /contato — notificação por e-mail via Resend. Server-only,
# NUNCA prefixar com NEXT_PUBLIC_. Lida só por src/lib/contact/notify.ts.
# Sem esta chave, a mensagem ainda é salva no Supabase normalmente — só
# a notificação por e-mail fica marcada como 'failed'.
# RESEND_API_KEY=coloque-a-chave-aqui

# Opcional: remetente das notificações do formulário de contato. Exige
# domínio verificado no Resend (ver instruções do time). Default no
# código se não definido: "Doopla <contato@doopla.pro>".
# CONTACT_EMAIL_FROM=Doopla <contato@doopla.pro>
